{
  "//": "이 폴더를 Claude Code 로 열면 자동 적용되는 설정입니다. 핵심은 UserPromptSubmit 훅 하나입니다.",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/inject_memory.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/retro_check.py"
          }
        ]
      }
    ]
  }
}
